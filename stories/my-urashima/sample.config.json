{
  "formatVersion": 1,
  "sample": "my-urashima",
  "parentStory": {
    "name": "urashima",
    "config": "../urashima/sample.config.json"
  },
  "profile": {
    "outputName": "my-urashima",
    "script": "external",
    "assets": "embedded"
  },
  "projectAssets": {
    "manifest": "project-assets.yml",
    "allowedRoots": [
      "assets"
    ]
  },
  "scriptReplacements": [
    {
      "description": "Pause before Princess pose exercise",
      "from": "action=Urashima:pose:Urashima-dance-1,Urashima-dance-2,Urashima-dance-1,Urashima-dance-2:dance1,dance2,dance1,dance2:Drum Funky,Drum Funky,Drum Funky,Drum Funky",
      "to": "action=wait:1"
    },
    {
      "description": "two-pose class names",
      "from": "#action=Princess:pose:p1,p2,p1,p2:pose1,pose2,pose1,pose2:Drum Funky,Drum Funky,Drum Funky,Drum Funky",
      "to": "#action=Princess:pose:p1,p2,p1,p2:p1,p2,p1,p2:Drum Funky,Drum Funky,Drum Funky,Drum Funky"
    },
    {
      "description": "three-pose class names",
      "from": "#action=Princess:pose:p1,p2,p3,p1,p2,p3:pose1,pose2,pose3,pose1,pose2,pose3:Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky",
      "to": "#action=Princess:pose:p1,p2,p3,p1,p2,p3:p1,p2,p3,p1,p2,p3:Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky"
    },
    {
      "description": "four-pose class names",
      "from": "#action=Princess:pose:p1,p2,p3,p4,p1,p2,p3,p4:pose1,pose2,pose3,pose4,pose1,pose2,pose3,pose4:Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky",
      "to": "#action=Princess:pose:p1,p2,p3,p4,p1,p2,p3,p4:p1,p2,p3,p4,p1,p2,p3,p4:Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky,Drum Funky"
    }
  ],
  "artifactsLock": "artifacts.lock.json",
  "dsl4": {
    "formatVersion": 1,
    "source": "my-urashima.k4.yml",
    "projectAssets": "project-assets-dsl4.yml",
    "output": "my-urashima-4.0.sb3",
    "blocksOutput": "my-urashima-blocks-4.0.sb3",
    "artifactsLock": "dsl4-artifacts.lock.json",
    "webArtifactsLock": "dsl4-web-artifacts.lock.json",
    "web": {
      "enabled": true,
      "inputProfile": "dsl4-workshop",
      "outputDirectory": "web-4.0",
      "outputFilename": "index.html",
      "maxOutputBytes": 134217728,
      "scriptMode": "external",
      "assets": "embedded-project",
      "audioUnlock": {
        "enabled": true
      },
      "packager": {
        "package": "@turbowarp/packager",
        "version": "3.13.0",
        "options": {
          "target": "html",
          "autoplay": true,
          "app": {
            "windowTitle": "my-urashima DSL 4.0 | TurboWarp紙芝居"
          },
          "cloudVariables": {
            "mode": "disabled"
          }
        }
      },
      "allowedOnlineDependencies": [
        {
          "urlPrefix": "https://sqs.prof.cuc.ac.jp/kamishibai/20260630/",
          "purpose": "ワークショップ台本で指定するTeachable Machine Poseモデル"
        }
      ],
      "runtimeCapabilities": [
        {
          "capability": "file-picker",
          "purpose": "DSL 4.0 YAMLを開く"
        },
        {
          "capability": "camera",
          "purpose": "Teachable Machine拡張によるポーズ認識"
        },
        {
          "capability": "audio",
          "purpose": "組み込み済み音声の再生"
        }
      ]
    }
  }
}
