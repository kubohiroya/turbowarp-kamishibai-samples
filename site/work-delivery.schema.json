{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "works"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "const": 1
    },
    "works": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "assets",
            "script",
            "sb3"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "assets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "mode"
                ],
                "properties": {
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "external",
                      "internal",
                      "project"
                    ]
                  }
                }
              }
            },
            "script": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "mode"
              ],
              "properties": {
                "format": {
                  "enum": [
                    "dsl4-yaml",
                    "dsl4-blocks",
                    "dsl32-txt"
                  ]
                },
                "mode": {
                  "enum": [
                    "external",
                    "embedded"
                  ]
                }
              }
            },
            "sb3": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "web": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
